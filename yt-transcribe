#!/usr/bin/env bash
set -euo pipefail

function usage() {
        cat <<"EOF"
Usage: yt-transcribe [options] <youtube-url>

Transcribe a youtube video into an easily readable HTML file

OPTIONS

    -help:          print this message
    -model:         specify the whisper model to use [default mlx-community/distil-whisper-large-v3]
    -outdir:        the directory to put the output files in. [default /tmp/yttranscribe_cache]
    -outfile:       the name of the output HTML file
    -thumbs:        enable thumbnail generation
    -thumbinterval: the interval between thumbnails, in seconds [default 30]
    -thumbwidth:    the width of the thumbnails, defaults to 640
    -adaptive:      use scene detection to adaptively choose thumbnail times
    -scenethresh:   scene detection threshold (0.0-1.0) [default 0.03]
    -mingap:        minimum seconds between adaptive thumbnails [default 10]
    -maxgap:        maximum seconds without a thumbnail (fallback interval) [default 60]
    -v:             print more verbose output

DEPENDENCIES

Assumes you have installed:

- ffmpeg
- jq
- mlx_whisper
- python
- yt-dlp

To install all on a mac:

`brew install ffmpeg jq python yt-dlp && pip install mlx_whisper`

EXAMPLES

Transcribe a youtube video:

    yt-transcribe 'https://www.youtube.com/watch?v=vP4iY1TtS3s'

Transcribe a video and insert thumbnails every 30 seconds (the default):

    yt-transcribe -thumbs 'https://www.youtube.com/watch?v=Ac7G7xOG2Ag'

Transcribe a video and insert thumbnails every 10 seconds:

    yt-transcribe -thumbs -thumbinterval 10 'https://www.youtube.com/watch?v=X48G7Y0VWW4'

Transcribe with adaptive scene-detection thumbnails:

    yt-transcribe -thumbs -adaptive 'https://www.youtube.com/watch?v=X48G7Y0VWW4'

Adaptive with custom thresholds (more sensitive, tighter gaps):

    yt-transcribe -thumbs -adaptive -scenethresh 0.02 -mingap 5 -maxgap 45 'https://www.youtube.com/watch?v=X48G7Y0VWW4'
Transcribe a video to the 'look-around-you' directory, with a filename 'water.html':

    yt-transcribe -thumbs -outdir ./look-around-you -outfile water.html 'https://www.youtube.com/watch?v=gaI6kBVyu00'

Transcribe a video using a different whisper model:

    yt-transcribe -model 'mlx-community/whisper-large-v3' 'https://www.youtube.com/watch?v=dQw4w9WgXcQ'

source: https://github.com/llimllib/yt-transcribe
EOF
        exit 1
}

CLR='\033[0m'
RED='\033[31m'
GREEN='\033[32m'

if [ -z "${1:-}" ]; then
    usage
fi

# default to suppressing ffmpeg and ytdlp output
ffmpegquiet=(-hide_banner -loglevel error)
ytdlpquiet=(--quiet)
thumbs=
thumbinterval=30 # default 30s between thumbs
outdir=
thumbwidth=640
model='mlx-community/distil-whisper-large-v3'
adaptive=
scenethresh=0.03
mingap=10
maxgap=60

# parse command line arguments
while true; do
    case $1 in
        -v)
            set -x
            ffmpegquiet=()
            ytdlpquiet=()
            shift
        ;;
        -thumbs)
            thumbs=yup
            shift
        ;;
        -thumbinterval)
            thumbinterval=$2
            shift 2
        ;;
        -thumbwidth)
            thumbwidth=$2
            shift 2
        ;;
        -adaptive)
            adaptive=yup
            shift
        ;;
        -scenethresh)
            scenethresh=$2
            shift 2
        ;;
        -mingap)
            mingap=$2
            shift 2
        ;;
        -maxgap)
            maxgap=$2
            shift 2
        ;;
        -outdir)
            outdir=$2
            shift 2
        ;;
        -outfile)
            outfile=$2
            shift 2
        ;;
        -model)
            model=$2
            shift 2
        ;;
        -help|--help)
            usage
        ;;
        *)
            break
        ;;
    esac
done

if [ ! -d "${outdir:-.}" ]; then
    printf "%boutdir %s does not exist%b" "$RED" "$outdir" "$CLR"
    exit 1
fi

# verify requirements are installed
if ! command -v ffmpeg &> /dev/null
then
    printf "%bYou must install ffmpeg%b: https://ffmpeg.org/download.html\n\n" "$RED" "$CLR"
fi

if ! command -v yt-dlp &> /dev/null
then
    printf "%bYou must install yt-dlp%b: https://github.com/yt-dlp/yt-dlp#installation\n\n" "$RED" "$CLR"
    exit 1
fi

if ! command -v mlx_whisper &> /dev/null
then
    printf "%bYou must install mlx_whisper%b: https://pypi.org/project/mlx-whisper/\n\n" "$RED" "$CLR"
    exit 1
fi

if ! command -v jq &> /dev/null
then
    printf "%bYou must install jq%b: https://jqlang.github.io/jq/download/\n\n" "$RED" "$CLR"
    exit 1
fi

# create a sanitized version of the URL name to use as a cache key
yturl_clean=${1//[^a-zA-Z0-9]/}

# create the cache folder if it doesn't exist
yttranscribe_cache_folder="/tmp/yttranscribe_cache"
if [ ! -d $yttranscribe_cache_folder ]; then
    mkdir $yttranscribe_cache_folder
fi

# get the video title, caching it for offline use
title_cache="$yttranscribe_cache_folder/title_$yturl_clean.txt"
if [ -f "$title_cache" ]; then
    title=$(cat "$title_cache")
else
    # Sometimes yt-dlp fails but manages to return the title
    # anyway, so proceed if it returns non-zero exit code but also a video title
    # https://github.com/yt-dlp/yt-dlp/issues/13635
    set +e
    title=$(yt-dlp --skip-download --print title "$1")
    yt_exit_code=$?
    set -e  # Re-enable exit-on-error

    if [[ -n "$title" ]]; then
        printf "%s" "$title" > "$title_cache"
    else
        echo "Failed to get title, exit code: $yt_exit_code" >&2
        exit 1
    fi
fi
echo "Title: $title"

# download audio of talk if we haven't yet
ytdl_audio_outfile="$yttranscribe_cache_folder/rawaudio_$yturl_clean.%(ext)s"
rawaudio=$(find "$yttranscribe_cache_folder" -name "rawaudio_$yturl_clean*")
if [ -z "$rawaudio" ]; then
    printf "%bdownloading talk audio%b\n" "$GREEN" "$CLR"
    if ! yt-dlp -f ba "$1" \
        "${ytdlpquiet[@]}" \
        -o "$ytdl_audio_outfile"; then
        printf "%bfailed running yt-dlp%b\n" "$RED" "$CLR"
        exit 1
    fi
fi
# re-run the `find` bc the file should exist now if it didn't before
rawaudio=$(find "$yttranscribe_cache_folder" -name "rawaudio_$yturl_clean*")


# download video talk if we need it (thumbnails are requested) and haven't yet
ytdl_video_outfile="$yttranscribe_cache_folder/rawvideo_$yturl_clean.%(ext)s"
rawvideo=$(find "$yttranscribe_cache_folder" -name "rawvideo_$yturl_clean*")
if [ -n "$thumbs" ] && [ -z "$rawvideo" ]; then
    printf "%bdownloading talk video%b\n" "$GREEN" "$CLR"
    if ! yt-dlp -f bv "$1" \
        "${ytdlpquiet[@]}" \
        -o "$ytdl_video_outfile"; then
        printf "%bfailed running yt-dlp%b\n" "$RED" "$CLR"
        exit 1
    fi
fi
rawvideo=$(find "$yttranscribe_cache_folder" -name "rawvideo_$yturl_clean*")


# convert into 16-bit wav file if we haven't yet
wavfile="$yttranscribe_cache_folder/audio_$yturl_clean.wav"
if [ ! -f "$wavfile" ]; then
    printf "%bconverting to wav%b\n" "$GREEN" "$CLR"
    if ! ffmpeg -y "${ffmpegquiet[@]}" \
        -i "${rawaudio}" \
        -ar 16000 -ac 1 -c:a pcm_s16le \
        "$wavfile"; then
        printf "%bfailed running ffmpeg%b\n" "$RED" "$CLR"
        exit 1
    fi
fi

# Create an HTML file to display. We'll add the text of the talk in the
# next branch
htmldir="${outdir:-$yttranscribe_cache_folder}"
transcript_html="${htmldir}/${outfile:-$yturl_clean.html}"
cat <<EOF >"$transcript_html"
<html><head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<style>
html {
    /* fixes font size on iOS */
    text-size-adjust: none;
    -webkit-text-size-adjust: none;
}
body {
  font-family: Georgia, "Book Antiqua", serif;
  margin: auto;
  justify-content: center;
  color: #333;
  max-width: 800px;
  padding-top: 100px;
  padding-left: 20px;
  padding-right: 20px;
}
p {
  font-size: 18px;
  line-height: 30px;
  word-wrap: break-word;
  overflow-wrap: break-word;
  hyphens: auto;
}
</style>
<title>$title - transcription by yt-transcribe</title>
</head><body><p><em>transcription of <a href="$1">$title</a></em><p>
EOF

# if no thumbs are requested, convert it into a text file and make an HTML page
if [ -z "$thumbs" ]; then
    # Convert it into a text file
    # mlx_whisper saves the input file into an output dir with the same filename
    # but with .txt instead of .wav. I wish it had an option to specify file output
    # name but it does not
    transcript="$yttranscribe_cache_folder/audio_$yturl_clean.txt"
    if [ ! -f "$transcript" ]; then
        printf "%btranscribing%b\n" "$GREEN" "$CLR"
        if ! mlx_whisper --model "$model" \
                 -f txt \
                 -o "$yttranscribe_cache_folder" \
                 --verbose False \
                 "$wavfile"; then
            printf "%bfailed running mlx_whisper%b\n" "$RED" "$CLR"
            exit 1
        fi
    fi
    sed -E 's/([.?])$/\1<p>/' "$transcript" >> "$transcript_html"
else
    # Get the duration of the audio file using ffprobe
    duration=$(ffprobe -v error -show_entries format=duration -of default=noprint_wrappers=1:nokey=1 "$wavfile")

    # Convert duration to seconds
    duration_sec=$(printf "%.0f" "$duration")

    # transcribe the video into json format
    transcript="$yttranscribe_cache_folder/audio_$yturl_clean.json"
    if [ ! -f "$transcript" ]; then
        printf "%btranscribing%b\n" "$GREEN" "$CLR"
        if ! mlx_whisper --model "$model" \
                 -f json \
                 -o "$yttranscribe_cache_folder" \
                 --verbose False \
                 "$wavfile"; then
            printf "%bfailed running mlx_whisper%b\n" "$RED" "$CLR"
            exit 1
        fi
    fi

    # Build the list of timestamps for thumbnails
    if [ -n "$adaptive" ]; then
        # Use scene detection to find timestamps adaptively
        printf "%bdetecting scene changes%b\n" "$GREEN" "$CLR"
        timestamps_file="$yttranscribe_cache_folder/timestamps_$yturl_clean.txt"
        ffmpeg -i "$rawvideo" \
            -vf "select='gt(scene,$scenethresh)',metadata=print" \
            -f null - 2>&1 \
            | grep "pts_time" \
            | sed 's/.*pts_time:\([0-9.]*\)/\1/' \
            | awk -v mingap="$mingap" -v maxgap="$maxgap" -v duration="$duration_sec" '
                BEGIN { last=-999 }
                {
                    t = $1 + 0
                    if (t - last >= mingap) {
                        # fill in fallback frames for any gap > maxgap
                        if (last >= 0 && t - last > maxgap) {
                            for (fill = last + maxgap; fill < t; fill += maxgap) {
                                printf "%.0f\n", fill
                            }
                        }
                        printf "%.0f\n", t
                        last = t
                    }
                }
                END {
                    # fill trailing gap
                    if (duration - last > maxgap) {
                        for (fill = last + maxgap; fill < duration; fill += maxgap) {
                            printf "%.0f\n", fill
                        }
                    }
                }' > "$timestamps_file"

        # Ensure we start at 0
        first_ts=$(head -1 "$timestamps_file")
        if [ "$first_ts" -gt 0 ] 2>/dev/null; then
            sed -i '' '1i\
0' "$timestamps_file"
        fi

        mapfile -t timestamps < "$timestamps_file"
        printf "%bfound %d thumbnail points%b\n" "$GREEN" "${#timestamps[@]}" "$CLR"
    else
        # Fixed interval timestamps (original behavior)
        timestamps=()
        for ((i=0; i<="$duration_sec"; i+=thumbinterval)); do
            timestamps+=("$i")
        done
    fi

    # Now loop through timestamps and output the HTML accordingly
    num_timestamps=${#timestamps[@]}
    for ((idx=0; idx<num_timestamps; idx++)); do
        ts=${timestamps[$idx]}
        # determine the end of this segment (start of next, or end of video)
        if ((idx + 1 < num_timestamps)); then
            next_ts=${timestamps[$((idx+1))]}
        else
            next_ts=$duration_sec
        fi

        imgName="${yturl_clean}_thumb_${ts}.jpg"
        img="$htmldir/$imgName"

        # grab a frame 1 second into the segment to avoid black frames
        ffmpeg -ss "$((ts+1))" -i "$rawvideo" \
            -vf "scale=${thumbwidth}:-1" \
            -vframes 1 -q:v 2 "$img" -y &> /dev/null
        printf '<img src="./%s"><p>' "$imgName" >> "$transcript_html"

        # pull the segment transcript(s) out of the json file and write
        # them to the HTML output
        segment=$(jq -r --argjson start "$ts" --argjson end "$next_ts" \
            '[.segments[] | select(.start >= $start and .start < $end).text] | join("<p>\n")' \
            "$transcript")
        printf "%s<p>\n" "$segment" >> "$transcript_html"
    done
fi

printf '<p><em><a href="https://github.com/llimllib/yt-transcribe">generated by yt-transcribe</a></em></body>' >> "$transcript_html"

open "$transcript_html"
